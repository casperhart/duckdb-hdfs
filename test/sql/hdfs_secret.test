# name: test/sql/hdfs_secret.test
# description: HDFS Secret configuration without a remote service.
# group: [sql]

require hdfs

statement ok
CREATE TEMPORARY SECRET root_hdfs (TYPE hdfs, FS_NAME 'hdfs://cluster', USER 'alice');

statement ok
CREATE TEMPORARY SECRET scoped_hdfs (TYPE hdfs, FS_NAME 'hdfs://cluster', SCOPE 'hdfs://cluster/finance', PRINCIPAL 'finance@EXAMPLE.COM', KEYTAB '/run/secrets/finance.keytab');

query T
SELECT name FROM which_secret('hdfs://cluster/finance/data.parquet', 'hdfs');
----
scoped_hdfs

query T
SELECT name FROM which_secret('hdfs://cluster/finance2/data.parquet', 'hdfs');
----
root_hdfs

query I
SELECT count(*) FROM which_secret('hdfs://other/data', 'hdfs');
----
0

query I
SELECT count(*) FROM duckdb_secrets() WHERE name='scoped_hdfs' AND secret_string LIKE '%finance.keytab%';
----
0

statement error
CREATE TEMPORARY SECRET invalid (TYPE hdfs, KEYTAB '/a.keytab');
----
requires fs_name

statement error
CREATE TEMPORARY SECRET invalid (TYPE hdfs, FS_NAME 'hdfs://cluster/path');
----
without a path

statement error
CREATE TEMPORARY SECRET invalid (TYPE hdfs, FS_NAME 'hdfs://cluster', SCOPE 'hdfs://other/root');
----
scope must belong

statement error
CREATE TEMPORARY SECRET invalid (TYPE hdfs, FS_NAME 'hdfs://cluster', KEYTAB '/a.keytab');
----
keytab requires principal

statement error
CREATE TEMPORARY SECRET invalid (TYPE hdfs, FS_NAME 'hdfs://cluster', PRINCIPAL 'a@EXAMPLE.COM', KEYTAB 'relative.keytab');
----
absolute path

statement error
CREATE TEMPORARY SECRET invalid (TYPE hdfs, FS_NAME 'hdfs://cluster', PRINCIPAL 'a@EXAMPLE.COM', CONF MAP {'hadoop.security.authentication': 'simple'});
----
requires kerberos authentication

statement error
CREATE TEMPORARY SECRET invalid (TYPE hdfs, FS_NAME 'hdfs://cluster', PRINCIPAL '');
----
cannot be empty

statement error
CREATE TEMPORARY SECRET invalid (TYPE hdfs, FS_NAME 'hdfs://cluster', USER NULL);
----
cannot be NULL

statement error
CREATE TEMPORARY SECRET invalid (TYPE hdfs, FS_NAME 'hdfs://cluster', CONF MAP {'bad': NULL});
----
cannot be NULL

statement error
CREATE TEMPORARY SECRET invalid (TYPE hdfs, FS_NAME 'hdfs://cluster', KRB5_CONF '/etc/krb5.conf');
----
Unknown parameter

statement ok
DROP SECRET scoped_hdfs;

statement ok
DROP SECRET root_hdfs;

statement error
CREATE TEMPORARY SECRET nul_user (TYPE hdfs, FS_NAME 'hdfs://cluster', USER ('a' || chr(0)));
----
cannot contain NUL

statement error
CREATE TEMPORARY SECRET nul_conf (TYPE hdfs, FS_NAME 'hdfs://cluster', CONF MAP {'key': ('a' || chr(0))});
----
cannot contain NUL

statement error
CREATE TEMPORARY SECRET nul_scope (TYPE hdfs, FS_NAME 'hdfs://cluster', SCOPE ('hdfs://cluster/' || chr(0)));
----
cannot contain NUL

statement error
CREATE TEMPORARY SECRET empty_keytab (TYPE hdfs, FS_NAME 'hdfs://cluster', PRINCIPAL 'a@REALM', KEYTAB '');
----
cannot be empty

statement error
CREATE TEMPORARY SECRET empty_fs (TYPE hdfs, FS_NAME '');
----
cannot be empty

statement ok
CREATE TEMPORARY SECRET conf_redaction (TYPE hdfs, FS_NAME 'hdfs://cluster', CONF MAP {'private': 'conf-value-to-redact'});

query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 'conf_redaction' AND contains(secret_string, 'conf-value-to-redact');
----
0

statement ok
DROP SECRET conf_redaction;
